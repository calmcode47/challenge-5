{
  "name": "occasio-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test 'scripts/__tests__/*.test.mjs' && npm run test --workspaces",
    "test:coverage": "node --test 'scripts/__tests__/*.test.mjs' && npm run test:coverage --workspaces",
    "check:hygiene": "node scripts/verify-hygiene.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:size": "node scripts/check-repo-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run check:hygiene && npm run check:bundle && npm run check:size"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.1"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "vitest": "^5.0.5"
  }
}
